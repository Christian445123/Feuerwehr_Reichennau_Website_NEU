# Kopiere diese Datei zu ".env" und trage die echten Zugangsdaten ein.
# Die ".env"-Datei selbst wird NICHT in Git eingecheckt (siehe .gitignore).

# ── Datenbank (MySQL/MariaDB) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ffrdb
DB_USER=ffr
DB_PASSWORD=

# ── SMTP (für das Kontaktformular) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FF Reichenau Website
SMTP_TO_EMAIL=reichenau@feuerwehr.tirol
