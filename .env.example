# Kopiere diese Datei zu ".env" und trage die echten Zugangsdaten ein.
# Die ".env"-Datei selbst wird NICHT in Git eingecheckt (siehe .gitignore).
#
# DB_PASSWORD und SMTP_PASSWORD werden verschlüsselt gespeichert (Präfix
# "enc:"), damit sie im Fall eines .env-Lecks nicht im Klartext lesbar sind.
# Verschlüsselten Wert erzeugen:
#   php config/encrypt-tool.php "mein-echtes-passwort"
# und die Ausgabe (inkl. "enc:"-Präfix) hier eintragen. Ein unverschlüsselter
# Klartext-Wert funktioniert übergangsweise weiterhin.

# ── Datenbank (MySQL/MariaDB) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ffrdb
DB_USER=ffr
DB_PASSWORD=enc:

# ── SMTP (für das Kontaktformular) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=enc:
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=FF Reichenau Website
SMTP_TO_EMAIL=reichenau@feuerwehr.tirol

# ── Discord-Webhooks für Logs (optional, leer lassen zum Deaktivieren) ──
# Aktivitäts-Log, Login-Log und Rate-Limit-Ereignisse werden bei Angabe
# zusätzlich zur Admin-Ansicht live an diese Discord-Kanäle gemeldet.
DISCORD_WEBHOOK_ACTIVITY=
DISCORD_WEBHOOK_LOGIN=
DISCORD_WEBHOOK_RATE_LIMIT=
